(defvar eww "eww")

;; (defvar vol_reveal false)
(deflisten vol_muted :initial "false" "scripts/mute_listen.sh")
(deflisten notif_list :initial "[]"
  "scripts/notif_daemon.py")

(defpoll time :interval "10s"
  "date '+%a, %d %b %H:%M'")

(defpoll network :interval "10s"
  "scripts/network.sh")

(deflisten volume :initial "0" "scripts/volume.sh")
(deflisten media :initial '{"status": "Stopped", "text": "LOADING...", "icon": "󰐊"}'
  "python3 scripts/marquee.py")

(deflisten workspaces_mon1 :initial "[]" "scripts/workspaces.sh HDMI-A-1")
(deflisten workspaces_mon2 :initial "[]" "scripts/workspaces.sh DP-1")

;; --- WIDGETY ---

(defwidget network_widget []
  (eventbox :onclick "nm-connection-editor &"
    (box :class "module network"
         :space-evenly false
         (label :class "icon" 
                :text {network =~ "Wired" ? "󰈀 " : " "})
         (label :text network))))

(defwidget workspace_list [workspace_data]
  (box :class "module workspaces"
       :space-evenly false
       :valign "center"
       (for ws in workspace_data
         (button :onclick "hyprctl dispatch workspace ${ws.id}"
           (box :valign "center" 
                :halign "center"
                :class "dot ${ws.occupied ? 'occupied' : ''} ${ws.active ? 'active' : ''}")))))

(defwidget volume_widget []
  (eventbox :onscroll "scripts/vol_osd.sh {} &"
            :class "volume-eventbox"
    (box :class "module" 
         :space-evenly false
      (label :class "icon" 
             :style {vol_muted == "true" ? "color: #F7635D; text-shadow: 0 0 5px #F7635D;" : ""}
             :text {vol_muted == "true" ? " " : " "})
      (label :text {vol_muted == "true" ? "MUTED" : "${volume}%"}
             :class {vol_muted == "true" ? "muted-text" : ""})
    )
  ))


(defwidget music [monitor_id]
  (eventbox :onscroll "echo {} | sed -e 's/up/next/g' -e 's/down/previous/g' | xargs -I {} playerctl -p ${media.name} {}"
            :onrightclick "playerctl -p ${media.name} stop"
    (box :class "module media"
         :orientation "h"
         :space-evenly false
         :width 330
      
      (label :class "icon" :text {media.status == "Playing" ? "󰝚 " : "󰏤 "})
      
      (label :class {media.active ? "" : "dead"}
             :text {media.text} 
             :halign "start"
             :width 300
             :limit-width 40))))

