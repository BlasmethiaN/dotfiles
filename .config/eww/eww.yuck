;; --- NOTIFICATION (LEAVING ACTIVE) ---

(defwidget notif_entry [notif]
  (box :class "notif-container"
       :orientation "v"
       :space-evenly false
    (box :class "notif-card"
         :orientation "v"
         :space-evenly false
      (box :class "notif-header"
           :space-evenly false
        (label :class "notif-pill" :text "INCOMING")
        (label :class "notif-app" :text {notif.app} :hexpand true :halign "start" :limit-width 20))
      
      (box :class "notif-body"
           :orientation "v"
           :space-evenly false
        (label :class "notif-title" 
               :text {notif.summary} 
               :halign "start" 
               :wrap true
               :limit-width 35)
        (label :class "notif-text" 
               :text {replace(notif.body, "\\n", " ")} 
               :halign "start" 
               :wrap true 
               :limit-width 80
               :visible {notif.body != ""}))
      
      (box :class "notif-footer"
           :space-evenly false
        (label :class "notif-pill" :text "ACK_REQUIRED")
        (label :class "notif-time" :text {notif.time} :hexpand true :halign "start")
        (button :class "notif-close"
                :onclick "dbus-send --session --type=method_call --dest=org.freedesktop.Notifications /org/freedesktop/Notifications org.freedesktop.Notifications.CloseNotification uint32:${notif.id}"
                "ACK")))))

(defwindow notif_stack
  :monitor 1
  :stacking "overlay"
  :exclusive false
  :focusable false
  :namespace "eww-notifs"
  :geometry (geometry :x "20px" :y "70px" :width "350px" :anchor "top right")
  (box :orientation "v"
       :space-evenly false
       :class "notif-root"
    (for entry in notif_list
      (notif_entry :notif entry))
  )
)

