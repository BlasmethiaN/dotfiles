;; --- MODULE GROUPING ---

(defwidget right_modules []
  (box :orientation "h" :space-evenly false :halign "end" :spacing 10
       (volume_widget)
       (network_widget)
       (box :class "module clock" :space-evenly false
            (label :class "icon" :text " ")
            (label :text time))))

;; --- BARS ---

(defwindow bar_mon1 :monitor 0 :windowtype "dock" :exclusive true
  :geometry (geometry :x "0%" :y "10px" :width "98%" :height "52px" :anchor "top center")
  (box :class "main-container"
    (centerbox :orientation "h" :class "bar-inner"
      (box :halign "start" :space-evenly false :spacing 10 :valign "center"
            (workspace_list :workspace_data workspaces_mon1)
            (music :monitor_id 1))
      (box)
      (box :halign "end" :space-evenly false :spacing 10 :valign "center"
            (right_modules)))))

(defwindow bar_mon2 :monitor 1 :windowtype "dock" :exclusive true
  :geometry (geometry :x "0%" :y "10px" :width "98%" :height "52px" :anchor "top center")
  (box :class "main-container"
    (centerbox :orientation "h"
      (box :halign "start" :space-evenly false :spacing 10 :valign "center"
            (workspace_list :workspace_data workspaces_mon2)
            (music :monitor_id 2))
      (box)
      (box :halign "end" :space-evenly false :spacing 10 :valign "center"
            (right_modules)))))
